# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env on your server and fill in
# ============================================

# Database
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=inventory_pos

# JWT (generate random strings: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_64_CHAR_STRING

# Domain
CORS_ORIGINS=https://inv-pos.mfaisalkahfi.my.id
NEXT_PUBLIC_API_URL=https://inv-pos.mfaisalkahfi.my.id/api/v1

# Midtrans (optional, fill when ready)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
